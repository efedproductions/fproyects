# Copia este fichero a .env y ajusta lo que necesites.
# Se carga solo al usar docker compose.

# Acceso al diario
DIARIO_USER=admin
# Deja la contraseña vacia para que el servidor genere una y la muestre en los logs:
#   docker compose logs app
DIARIO_PASSWORD=

# Donde se publica si no usas el proxy HTTPS (solo accessible desde el propio servidor)
DIARIO_BIND=127.0.0.1
DIARIO_PORT=8300

# Ponlo a 1 cuando sirvas por HTTPS: la cookie de sesion viaja solo encriptada
DIARIO_SECURE_COOKIE=0

# Solo con compose.https.yaml: tu dominio apuntando a la IP del servidor
DOMAIN=