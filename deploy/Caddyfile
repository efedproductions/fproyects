# Caddy se encarga del HTTPS solo: pide el certificado a Let's Encrypt y lo renueva.
# Para la IP o un dominio sin DNS publico, cambia la linea de abajo por:
#     http://{$DOMAIN} {
#     (y entonces no habra HTTPS: no expongas el diario a internet sin el.)

{$DOMAIN} {
    encode zstd gzip
    reverse_proxy app:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        X-Frame-Options "SAMEORIGIN"
    }
}